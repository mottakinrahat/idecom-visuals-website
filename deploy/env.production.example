# Copy to .env.production ON THE VPS (never commit the real file — it is git-ignored).
#   cp deploy/env.production.example .env.production && chmod 600 .env.production

# Public domain (no https://, no trailing slash). The A record must point to this VPS.
DOMAIN=

# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=

# GitHub user/org that owns the repo, LOWERCASE — images are ghcr.io/<this>/idecom-backend|frontend
GHCR_NAMESPACE=

# Tag of the images to run. deploy.sh manages this for you; "latest" is the fallback.
# IMAGE_TAG=latest

# ---- Cloudflare R2 file uploads (same names as backend/.env). Leave empty to keep files on the server volume.
# The bucket must be publicly readable (r2.dev URL or custom domain) — that address goes in CLOUDFLARE_R2_PUBLIC_URL.
CLOUDFLARE_S3_API_ENDPOINT=
CLOUDFLARE_ACCESSKEY_ID=
CLOUDFLARE_SECRETACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# ---- Database: Neon PostgreSQL (required). All dashboard data is stored here; tables are created automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
